NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/socialapp
# REQUIRED in production: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_DAYS=7
UPLOADS_DIR=./uploads
# Only needed if the client is served from a different origin than the API (dev uses the Vite proxy instead)
CLIENT_ORIGIN=
# Defaults to true in production (needs HTTPS). Set false ONLY for plain-HTTP testing.
COOKIE_SECURE=

# --- Email ---
# Leave SMTP_HOST empty in development: emails are printed in the server console instead of being sent.
APP_URL=http://localhost:5173
MAIL_FROM=Sociable <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to true in production, false in development
REQUIRE_EMAIL_VERIFICATION=

# --- Deployment / testing switches (all optional) ---
# Serve the built React app from Express (single-service hosting). Path relative to server/.
CLIENT_DIR=
# Number of reverse proxies in front of the API (Caddy = 1).
TRUST_PROXY=
# Demo hosting only: log emails instead of sending (password reset won't work).
ALLOW_NO_SMTP=
# Load testing only. NEVER on a public server.
RATE_LIMIT_DISABLED=
