# Copy to .env next to docker-compose.yml

# Public domain pointing at this server (A/AAAA record). Caddy gets a TLS certificate for it automatically.
DOMAIN=example.com
# Public URL of the site; used for links inside emails.
APP_URL=https://example.com
# Generate with: openssl rand -hex 48
JWT_SECRET=

# --- Email (SMTP) --- see README "Email / SMTP"
MAIL_FROM=Sociable <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true only for port 465; false for 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# true = unverified accounts can't post/comment/message
REQUIRE_EMAIL_VERIFICATION=true
